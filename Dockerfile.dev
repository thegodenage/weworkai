FROM elixir:1.20.2-otp-29

# inotify-tools: file_system backend that drives code reload and live reload.
RUN apt-get update \
  && apt-get install -y --no-install-recommends inotify-tools \
  && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

WORKDIR /app

CMD ["sh", "-c", "mix deps.get && mix ash.setup && exec mix phx.server"]
